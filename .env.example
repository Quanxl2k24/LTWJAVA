# ===================================================================
# Application Environment Variables Template
# Copy this file to .env and adjust the values according to your local environment.
# DO NOT commit the .env file containing sensitive credentials to Git!
# ===================================================================

# Server Configuration
SERVER_PORT=8080
APP_NAME=LTWJAVA
APP_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ltwjava_db
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security / JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Default Admin Account Seed
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=0987654321
ADMIN_FULL_NAME=System Administrator

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Docs / Swagger
SWAGGER_ENABLED=true
